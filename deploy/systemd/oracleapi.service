[Unit]
Description=Market Data Oracle - read-only dataset API
Wants=network-online.target
After=local-fs.target lightercollector.service

[Service]
Type=simple
User=traderbot
Group=traderbot
ExecStart=/opt/overnight-strategy/current/bin/oracleapi -root /mnt/trading/recorder/lighter -listen 127.0.0.1:8083
Restart=always
RestartSec=5
UnsetEnvironment=LIGHTER_ACCOUNT_INDEX LIGHTER_API_KEY_INDEX LIGHTER_API_PRIVATE_KEY LIGHTER_AUTH_TOKEN LIGHTER_EXECUTOR_TOKEN
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/mnt/trading/recorder/lighter
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
UMask=0077

[Install]
WantedBy=multi-user.target
