[Unit]
Description=Overnight Strategy - continuous Lighter market recorder
Wants=network-online.target
After=local-fs.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=traderbot
Group=traderbot
EnvironmentFile=-/etc/overnight.env
EnvironmentFile=-/etc/overnight-strategy.env
EnvironmentFile=-/etc/overnight/runtime.env
ExecStart=/opt/overnight-strategy/current/bin/lightercollector -store /mnt/trading/recorder/lighter -health-port 8082
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/mnt/trading /var/lib/overnight
UMask=0077

[Install]
WantedBy=multi-user.target
