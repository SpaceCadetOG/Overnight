[Unit]
Description=Overnight Strategy - frozen 05:00 CT paper plans
After=lightercollector.service
Requires=lightercollector.service

[Service]
Type=oneshot
User=traderbot
Group=traderbot
EnvironmentFile=-/etc/overnight-strategy.env
ExecStart=/opt/overnight-strategy/build/dailyplans -store /mnt/trading/research -dry-run=true -paper-equity=100
