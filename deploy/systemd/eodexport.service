[Unit]
Description=Overnight Strategy - EOD forensics and shadow ML export
After=network-online.target lightercollector.service

[Service]
Type=oneshot
User=traderbot
Group=traderbot
WorkingDirectory=/opt/overnight-strategy/current
EnvironmentFile=-/etc/overnight.env
EnvironmentFile=-/etc/overnight-strategy.env
EnvironmentFile=-/etc/overnight/runtime.env
ExecStart=/opt/overnight-strategy/current/bin/eodexport -store /mnt/trading/research -out /mnt/trading/packages/pending -market-data-root /mnt/trading/recorder/lighter
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/mnt/trading /var/lib/overnight
UMask=0077
