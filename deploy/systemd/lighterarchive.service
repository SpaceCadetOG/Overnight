[Unit]
Description=Overnight Strategy - Archive and upload closed Lighter day
After=network-online.target lightercollector.service
Wants=network-online.target

[Service]
Type=oneshot
User=traderbot
WorkingDirectory=/opt/overnight-strategy/current
EnvironmentFile=-/etc/overnight-cloud.env
EnvironmentFile=-/etc/overnight/runtime.env
ExecStart=/opt/overnight-strategy/current/scripts/archive-and-upload.sh
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/mnt/trading /var/lib/overnight
UMask=0077
