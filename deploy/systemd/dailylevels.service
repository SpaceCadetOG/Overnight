[Unit]
Description=Overnight Strategy - generate daily basket levels
After=dailyplans.service
Wants=lightercollector.service

[Service]
Type=oneshot
User=traderbot
Group=traderbot
EnvironmentFile=-/etc/overnight.env
EnvironmentFile=-/etc/overnight-strategy.env
EnvironmentFile=-/etc/overnight/runtime.env
ExecStart=/opt/overnight-strategy/current/bin/dailylevels -all
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/mnt/trading /var/lib/overnight
UMask=0077
