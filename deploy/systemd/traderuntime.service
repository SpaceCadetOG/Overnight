[Unit]
Description=Overnight Strategy - continuous paper and gated live lifecycle
After=network-online.target lightercollector.service
Wants=network-online.target
Requires=lightercollector.service

[Service]
Type=simple
User=traderbot
Group=traderbot
WorkingDirectory=/opt/overnight-strategy
EnvironmentFile=-/etc/overnight-strategy.env
ExecStart=/opt/overnight-strategy/build/traderuntime -store /mnt/trading/research -live=true -poll=5s
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
