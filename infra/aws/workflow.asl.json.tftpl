{
  "Comment": "Trade Forensics processing; no trading or order-routing path",
  "StartAt": "Normalize",
  "States": {
    "Normalize": {"Type":"Task","Resource":"arn:aws:states:::ecs:runTask.sync","Parameters":{"Cluster":"${cluster}","TaskDefinition":"${normalize}","LaunchType":"FARGATE","NetworkConfiguration":{"AwsvpcConfiguration":{"Subnets":${subnets},"SecurityGroups":${security_groups},"AssignPublicIp":"DISABLED"}}},"Retry":[{"ErrorEquals":["States.TaskFailed"],"IntervalSeconds":10,"MaxAttempts":2,"BackoffRate":2}],"Catch":[{"ErrorEquals":["States.ALL"],"Next":"Quarantine"}],"Next":"ReconstructL2"},
    "ReconstructL2": {"Type":"Task","Resource":"arn:aws:states:::ecs:runTask.sync","Parameters":{"Cluster":"${cluster}","TaskDefinition":"${reconstruct_l2}","LaunchType":"FARGATE","NetworkConfiguration":{"AwsvpcConfiguration":{"Subnets":${subnets},"SecurityGroups":${security_groups},"AssignPublicIp":"DISABLED"}}},"Retry":[{"ErrorEquals":["States.TaskFailed"],"MaxAttempts":2}],"Catch":[{"ErrorEquals":["States.ALL"],"Next":"Quarantine"}],"Next":"ReconstructTrades"},
    "ReconstructTrades": {"Type":"Task","Resource":"arn:aws:states:::ecs:runTask.sync","Parameters":{"Cluster":"${cluster}","TaskDefinition":"${reconstruct_trades}","LaunchType":"FARGATE","NetworkConfiguration":{"AwsvpcConfiguration":{"Subnets":${subnets},"SecurityGroups":${security_groups},"AssignPublicIp":"DISABLED"}}},"Catch":[{"ErrorEquals":["States.ALL"],"Next":"Quarantine"}],"Next":"Features"},
    "Features": {"Type":"Task","Resource":"arn:aws:states:::ecs:runTask.sync","Parameters":{"Cluster":"${cluster}","TaskDefinition":"${features}","LaunchType":"FARGATE","NetworkConfiguration":{"AwsvpcConfiguration":{"Subnets":${subnets},"SecurityGroups":${security_groups},"AssignPublicIp":"DISABLED"}}},"Catch":[{"ErrorEquals":["States.ALL"],"Next":"Quarantine"}],"Next":"Forensics"},
    "Forensics": {"Type":"Task","Resource":"arn:aws:states:::ecs:runTask.sync","Parameters":{"Cluster":"${cluster}","TaskDefinition":"${forensics}","LaunchType":"FARGATE","NetworkConfiguration":{"AwsvpcConfiguration":{"Subnets":${subnets},"SecurityGroups":${security_groups},"AssignPublicIp":"DISABLED"}}},"Catch":[{"ErrorEquals":["States.ALL"],"Next":"Quarantine"}],"Next":"Counterfactual"},
    "Counterfactual": {"Type":"Task","Resource":"arn:aws:states:::ecs:runTask.sync","Parameters":{"Cluster":"${cluster}","TaskDefinition":"${counterfactual}","LaunchType":"FARGATE","NetworkConfiguration":{"AwsvpcConfiguration":{"Subnets":${subnets},"SecurityGroups":${security_groups},"AssignPublicIp":"DISABLED"}}},"Catch":[{"ErrorEquals":["States.ALL"],"Next":"Quarantine"}],"Next":"DataQuality"},
    "DataQuality": {"Type":"Task","Resource":"arn:aws:states:::ecs:runTask.sync","Parameters":{"Cluster":"${cluster}","TaskDefinition":"${data_quality}","LaunchType":"FARGATE","NetworkConfiguration":{"AwsvpcConfiguration":{"Subnets":${subnets},"SecurityGroups":${security_groups},"AssignPublicIp":"DISABLED"}}},"Catch":[{"ErrorEquals":["States.ALL"],"Next":"Quarantine"}],"Next":"Publish"},
    "Publish": {"Type":"Task","Resource":"arn:aws:states:::ecs:runTask.sync","Parameters":{"Cluster":"${cluster}","TaskDefinition":"${publish}","LaunchType":"FARGATE","NetworkConfiguration":{"AwsvpcConfiguration":{"Subnets":${subnets},"SecurityGroups":${security_groups},"AssignPublicIp":"DISABLED"}}},"Catch":[{"ErrorEquals":["States.ALL"],"Next":"Quarantine"}],"Next":"ShadowInference"},
    "ShadowInference": {"Type":"Task","Resource":"arn:aws:states:::ecs:runTask.sync","Parameters":{"Cluster":"${cluster}","TaskDefinition":"${shadow_inference}","LaunchType":"FARGATE","NetworkConfiguration":{"AwsvpcConfiguration":{"Subnets":${subnets},"SecurityGroups":${security_groups},"AssignPublicIp":"DISABLED"}}},"Catch":[{"ErrorEquals":["States.ALL"],"Next":"Quarantine"}],"Next":"DailyReport"},
    "DailyReport": {"Type":"Task","Resource":"arn:aws:states:::ecs:runTask.sync","Parameters":{"Cluster":"${cluster}","TaskDefinition":"${daily_report}","LaunchType":"FARGATE","NetworkConfiguration":{"AwsvpcConfiguration":{"Subnets":${subnets},"SecurityGroups":${security_groups},"AssignPublicIp":"DISABLED"}}},"Catch":[{"ErrorEquals":["States.ALL"],"Next":"Quarantine"}],"Next":"Complete"},
    "Complete": {"Type":"Task","Resource":"arn:aws:states:::dynamodb:updateItem","Parameters":{"TableName":"${registry}","Key":{"package_id":{"S.$":"$.package_id"}},"UpdateExpression":"SET processing_status = :s, processed_at = :t","ExpressionAttributeValues":{":s":{"S":"COMPLETE"},":t":{"S.$":"$$.State.EnteredTime"}}},"End":true},
    "Quarantine": {"Type":"Task","Resource":"arn:aws:states:::sns:publish","Parameters":{"TopicArn":"${alerts}","Message.$":"States.JsonToString($)"},"Next":"Failed"},
    "Failed": {"Type":"Fail","Error":"TradeForensicsProcessingFailed","Cause":"Package processing failed and requires quarantine review"}
  }
}
