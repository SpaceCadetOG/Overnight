FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/lightercollector ./cmd/lightercollector

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/lightercollector /lightercollector
VOLUME ["/data"]
EXPOSE 8082
ENTRYPOINT ["/lightercollector", "-store", "/data", "-health-port", "8082"]
