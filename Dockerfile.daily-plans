FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/dailyplans ./cmd/dailyplans

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/dailyplans /dailyplans
VOLUME ["/data"]
ENTRYPOINT ["/dailyplans", "-dry-run=true", "-store", "/data"]
